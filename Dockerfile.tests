# ========================================================
# STAGE 0 : Builder (Compile et génère les métadonnées de compilation)
# ========================================================
FROM fedora:44 AS builder

# Installation de tous les outils de compilation et d'analyse
RUN dnf install -y \
        gcc \
        make \
        cmake \
        git \
        wget \
        tar \
        libcmocka \
        libcmocka-devel \
        clang \
        clang-tools-extra \
        bear \
        cppcheck \
    && dnf clean all

WORKDIR /app
COPY . .

# Génère compile_commands.json pour TOUT le projet
# Ceci est crucial pour que clang-tidy fonctionne correctement
RUN make clean && \
    bear -- make -B all tests_runner

# ========================================================
# STAGE 1 : Lint (Analyse de la qualité du code)
# ========================================================
FROM builder AS lint

# 1. Analyse par clang-tidy (Utilise le contexte de compilation généré par bear)
# On utilise || true pour que les warnings ne bloquent pas le build, mais l'analyse est faite.
RUN echo "--- Running clang-tidy analysis ---" && \
    clang-tidy -p /app src/*.c --warnings-as-errors=* || true

# 2. Analyse par cppcheck (Analyse statique générale)
# Si cppcheck trouve des erreurs critiques, il échouera le build de l'image 'lint'.
RUN echo "--- Running cppcheck analysis ---" && \
    cppcheck --enable=all --error-exitcode=1 /app/src/*.c /app/tests/*.c

# ========================================================
# STAGE 2 : Test Runner (Exécution des tests unitaires)
# ========================================================
FROM fedora:44 AS test

# Installation des bibliothèques nécessaires pour l'exécution des tests
RUN dnf install -y libcmocka && \
    dnf clean all

# Copie les artefacts compilés de l'étape 'builder'
COPY --from=builder /app/tests_runner /tests_runner
# Copie les fichiers sources/config nécessaires à l'exécution
COPY . /app

WORKDIR /app

# Le point d'entrée exécute le runner compilé
ENTRYPOINT ["/tests_runner"]
